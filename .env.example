# MongoDB connection string. Prisma's MongoDB connector needs a replica set for
# transactions — Atlas gives you one by default, a bare local `mongod` does not.
MONGODB_URI=

# The origin the browser actually visits. better-auth signs cookies and builds
# the Google OAuth callback against this, so a wrong value breaks sign-in and
# nothing else. Must include the scheme.
BETTER_AUTH_URL="http://localhost:3000"

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add <BETTER_AUTH_URL>/api/auth/callback/google as an
# authorised redirect URI.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# https://openrouter.ai/keys — one server-side key pays for every user, whose
# spend is metered against User.balanceMicros.
OPENROUTER_API_KEY=
